{
  "kind": "collectionType",
  "collectionName": "programs",
  "info": {
    "name": "program",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "status": {
      "type": "enumeration",
      "enum": [
        "current",
        "archived"
      ]
    },
    "summary": {
      "type": "text"
    },
    "body": {
      "type": "richtext"
    },
    "attachments": {
      "collection": "file",
      "via": "related",
      "allowedTypes": [
        "files"
      ],
      "plugin": "upload",
      "required": false,
      "pluginOptions": {}
    },
    "tags": {
      "collection": "tag",
      "via": "programs",
      "dominant": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "federal",
        "state"
      ],
      "required": true
    },
    "searchMeta": {
      "type": "text"
    },
    "posts": {
      "via": "programs",
      "collection": "post"
    },
    "grants": {
      "via": "programs",
      "collection": "grant",
      "dominant": true
    }
  }
}
