{
  "kind": "collectionType",
  "collectionName": "events",
  "info": {
    "name": "event",
    "description": ""
  },
  "options": {
    "increments": true,
    "timestamps": true,
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name"
    },
    "start": {
      "type": "datetime",
      "required": true
    },
    "end": {
      "type": "datetime",
      "required": true
    },
    "summary": {
      "type": "text"
    },
    "details": {
      "type": "richtext"
    },
    "timed": {
      "type": "boolean",
      "default": true
    },
    "tags": {
      "via": "events",
      "collection": "tag",
      "dominant": true
    },
    "attachments": {
      "collection": "file",
      "via": "related",
      "allowedTypes": [
        "files",
        "videos"
      ],
      "plugin": "upload",
      "required": false,
      "pluginOptions": {}
    },
    "splash": {
      "model": "file",
      "via": "related",
      "allowedTypes": [
        "images",
        "files",
        "videos"
      ],
      "plugin": "upload",
      "required": false,
      "pluginOptions": {}
    },
    "posts": {
      "via": "events",
      "collection": "post",
      "dominant": true
    },
    "meetings": {
      "via": "events",
      "collection": "meeting",
      "dominant": true
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "community",
        "conference",
        "external",
        "general",
        "holiday",
        "meeting",
        "party",
        "seminar",
        "summit",
        "training",
        "webinar"
      ]
    },
    "grants": {
      "via": "events",
      "collection": "grant"
    },
    "searchMeta": {
      "type": "text"
    }
  }
}
