# Strapi 3 source database — contains internal Strapi tables and password hashes
docs/strapi-3-source/data.db

# Strapi 3 runtime config snapshot — server.js holds an ADMIN_JWT_SECRET
# fallback; the migration tool doesn't read any of these files (it only needs
# api/<type>/models/*.settings.json and components/), so the whole dir stays
# local-only.
docs/strapi-3-source/config/

# Dependencies
node_modules/
.pnpm-store/

# Migration working directories (regenerated by phase scripts)
migration/data/
migration/output/

# Generated artifact — recreated by Phase 1b on every run
migration/config/field-map.json

# Per-developer config override (root-level only — don't hide Strapi 3 model files)
/config.js

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Editor / OS
.DS_Store
.vscode/*
!.vscode/extensions.json
.idea/

# Environment
.env
.env.local
.env.*.local
