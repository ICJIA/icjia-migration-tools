# Migration tool environment variables.
#
# Copy to `.env` and fill in real values. Both `.env` and any `.env.*.local`
# variant are gitignored. The migration loader (migration/lib/load-config.js)
# auto-reads `.env` at startup; values exported in the calling shell still
# win over `.env` values, so CI / one-off overrides work as expected.
#
# After creating .env, lock it down:
#   chmod 600 .env

# ─── Required for any phase that writes to Strapi 5 ───
# Full-access API token from Strapi 5 admin → Settings → API Tokens
STRAPI5_TOKEN=

# ─── Optional (only set if your setup needs them) ───

# Override Strapi 5 URLs (defaults come from config.dev.js / config.prod.js)
# STRAPI5_API_URL=http://localhost:1340
# STRAPI5_GRAPHQL_URL=http://localhost:1340/graphql
# STRAPI5_DB_PATH=../icjia-public-strapi5/.tmp/data.db
# STRAPI5_PROJECT_PATH=../icjia-public-strapi5

# Override Strapi 3 source (default: agency.icjia-api.cloud, no token needed)
# STRAPI3_TOKEN=
# STRAPI3_GRAPHQL_URL=https://agency.icjia-api.cloud/graphql
# STRAPI3_API_URL=https://agency.icjia-api.cloud
# STRAPI3_SQLITE_PATH=./docs/strapi-3-source/data.db
# STRAPI3_SOURCE_PATH=./docs/strapi-3-source

# ─── Required for remote (production) write phases — see reset-remote.js ───
# SSH_HOST=v2.example.com
# SSH_USER=forge
# SSH_STRAPI_DIR=/home/forge/v2.example.com/strapi5
# SSH_DB_RELATIVE_PATH=.tmp/data.db

# ─── Behavior toggles ───

# Suppress the "secret-shaped value in plaintext" warning. Default behavior
# is to keep the warning visible — leave unset.
# MIGRATION_SUPPRESS_SECRET_WARNINGS=1

# Disable the umask 0o077 startup hardening (rare).
# MIGRATION_DISABLE_UMASK=1

# Skip the .env auto-loader (use only shell env vars).
# MIGRATION_DISABLE_DOTENV=1

# Allow API tokens over plaintext HTTP to non-localhost (testing only).
# ALLOW_INSECURE_HTTP=1
